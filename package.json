{
  "name": "court-case-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --prefix server",
    "test:auth": "npm run test:auth --prefix server",
    "test:cases": "npm run test:cases --prefix server",
    "test:advocates": "npm run test:advocates --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:reset": "npm run db:reset --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "db:verify": "npm run db:verify --prefix server"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2"
  }
}
